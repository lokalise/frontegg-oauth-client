{
    "name": "@lokalise/frontegg-oauth-client",
    "version": "1.2.1",
    "scripts": {
        "build": "vite build",
        "lint:ts": "tsc --noEmit",
        "lint": "biome check && pnpm run lint:ts",
        "lint:fix": "biome check --write",
        "test": "vitest run",
        "changeset": "changeset",
        "ci:publish": "pnpm run build && changeset publish"
    },
    "files": ["dist"],
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.cjs",
            "import": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.4",
        "@changesets/cli": "^3.0.3",
        "@lokalise/biome-config": "^4.0.0",
        "@lokalise/package-vite-config": "^4.0.0",
        "jsdom": "^29.1.1",
        "msw": "^2.15.0",
        "typescript": "^6.0.3",
        "vite": "^6.3.5",
        "vitest": "^3.2.4"
    },
    "engines": {
        "node": ">=20"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24.22.0 || ^26.12.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "pnpm",
            "version": "^12.10.0",
            "onFail": "error"
        }
    }
}
